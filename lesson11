      <div class="quiz-question">
        <p class="quiz-question-title">7. При каком условии возникает обязанность уплаты НДС по методу «по отгрузке»?</p>
        <button class="quiz-option" onclick="checkTest(this, false)">А) При поступлении денежных средств на расчетный счет</button>
        <button class="quiz-option" onclick="checkTest(this, true)">Б) При передаче права собственности на товар покупателю</button>
        <button class="quiz-option" onclick="checkTest(this, false)">В) В конце налогового периода независимо от отгрузки</button>
        <button class="quiz-option" onclick="checkTest(this, false)">Г) При подписании договора поставки</button>
        <div class="quiz-feedback"></div>
      </div>

      <div class="quiz-question">
        <p class="quiz-question-title">8. На каком счете отражаются штрафы и пени, начисленные налоговыми органами?</p>
        <button class="quiz-option" onclick="checkTest(this, false)">А) Дт 26 «Общехозяйственные расходы»</button>
        <button class="quiz-option" onclick="checkTest(this, false)">Б) Дт 44 «Издержки обращения»</button>
        <button class="quiz-option" onclick="checkTest(this, true)">В) Дт 99 «Прибыли и убытки»</button>
        <button class="quiz-option" onclick="checkTest(this, false)">Г) Дт 81 «Использование прибыли»</button>
        <div class="quiz-feedback"></div>
      </div>

      <div class="quiz-question">
        <p class="quiz-question-title">9. Задача: Налогооблагаемая прибыль организации составила 100 000 руб. Базовая ставка — 18%. Чему равен налог на прибыль?</p>
        <button class="quiz-option" onclick="checkTest(this, false)">А) 10 000 руб.</button>
        <button class="quiz-option" onclick="checkTest(this, true)">Б) 18 000 руб.</button>
        <button class="quiz-option" onclick="checkTest(this, false)">В) 20 000 руб.</button>
        <button class="quiz-option" onclick="checkTest(this, false)">Г) 15 000 руб.</button>
        <div class="quiz-feedback"></div>
      </div>

      <div class="quiz-question">
        <p class="quiz-question-title">10. Задача: Товар куплен за 110 000 руб. (НДС 10 000), продан за 165 000 руб. (НДС 15 000). Сколько НДС подлежит уплате в бюджет?</p>
        <button class="quiz-option" onclick="checkTest(this, false)">А) 15 000 руб. — вся сумма исходящего НДС</button>
        <button class="quiz-option" onclick="checkTest(this, true)">Б) 5 000 руб. — разница между исходящим и входящим НДС</button>
        <button class="quiz-option" onclick="checkTest(this, false)">В) 10 000 руб. — сумма входного НДС</button>
        <button class="quiz-option" onclick="checkTest(this, false)">Г) 25 000 руб. — сумма обоих НДС</button>
        <div class="quiz-feedback"></div>
      </div>
    </section>

  </main>

  <div id="smart-footer"></div>

  <script>
    // Функция переключения примеров (как в Уроках 4 и 7)
    function toggleExample(id, btn) {
      const content = document.getElementById(id);
      
      if (content.classList.contains('hidden')) {
        content.classList.remove('hidden');
        btn.innerHTML = '🙈 Скрыть пример';
        btn.className = 'w-full px-4 py-3 rounded-xl text-sm font-semibold transition bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:opacity-90 mt-4';
      } else {
        content.classList.add('hidden');
        btn.innerHTML = '👁 Показать пример расчета и проводки';
        btn.className = 'w-full px-4 py-3 rounded-xl text-sm font-semibold transition bg-emerald-600 text-white dark:bg-emerald-500 dark:text-slate-950 hover:opacity-90 mt-4';
      }
    }

    // Функция проверки тестов
    function checkTest(btn, isCorrect) {
      const question = btn.closest('.quiz-question');
      const feedback = question.querySelector('.quiz-feedback');
      const allOptions = question.querySelectorAll('.quiz-option');
      
      allOptions.forEach(opt => opt.classList.remove('correct', 'incorrect'));
      feedback.classList.remove('correct', 'incorrect', 'show');
      
      if (isCorrect) {
        btn.classList.add('correct');
        feedback.classList.add('correct', 'show');
        feedback.textContent = '✅ Верно!';
      } else {
        btn.classList.add('incorrect');
        feedback.classList.add('incorrect', 'show');
        feedback.textContent = '❌ Неверно. Попробуйте ещё раз.';
      }
    }
  </script>

  <script src="navigation.js"></script>
